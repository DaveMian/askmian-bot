# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram Chat ID (from @userinfobot)
ADMIN_CHAT_ID=YOUR_CHAT_ID_HERE

# Stripe Payment Token for Telegram Payments (from @BotFather -> /mybots -> Payments)
# Optional - only needed for card payments inside Telegram
STRIPE_TOKEN=YOUR_STRIPE_PROVIDER_TOKEN

# Payment Provider Name (stripe, etc.)
PAYMENT_PROVIDER=stripe

# Currency (AED for UAE)
CURRENCY=AED
